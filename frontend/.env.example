# Frontend Environment Configuration Example
# Set this to your production backend API base URL when deploying (e.g. https://api.veloop.io/api)
VITE_API_URL=http://localhost:5000/api

# Demo Mode Toggle
# Set to 'true' in staging/demo environments to show Demo State Switcher and demo sign-in chips.
# Set to 'false' or omit in production builds to remove all demo controls from the DOM.
VITE_DEMO_MODE=true

