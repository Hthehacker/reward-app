# ==============================================================================
# VELOOP Rewards API - Environment Configuration Example
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=development

# Demo Environment Control
# Set to 'true' in staging/demo environments to enable demo personas, switcher and seed resetting.
# MUST BE 'false' or omitted in production. Production unconditionally disables demo endpoints.
DEMO_MODE=true

# MongoDB Connection String (Atlas URI or Local MongoDB instance)
# Safety lock: Databases with 'prod' or 'production' in name/URI automatically reject reset-demo
MONGO_URI=mongodb://127.0.0.1:27017/veloop_rewards

# JWT Cryptographic Secrets (generate strong random secrets for production, e.g. via `openssl rand -base64 48`)
JWT_SECRET=replace_with_strong_random_jwt_secret_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_strong_random_refresh_secret_min_32_chars

# Frontend Client Origin (for strict CORS & secure cookie handling)
CLIENT_URL=http://localhost:5173

# Initial Seed Admin Account (used by `npm run seed-admin`)
ADMIN_EMAIL=admin@veloop.io
ADMIN_PASSWORD=ChangeMeSecurePass2026!
